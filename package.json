{
  "name": "strumentario",
  "version": "0.0.1",
  "author": "zanuka",
  "private": true,
  "description": "Local-first MCP content toolkit — one schema → shared instruments for agents and humans",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -b && pnpm --filter @strumentario/widget run typecheck:fixtures",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "pnpm --filter @strumentario/server run build && pnpm --filter @strumentario/evals run eval",
    "eval:local": "pnpm build && pnpm --filter @strumentario/evals run eval:local",
    "eval:agent": "pnpm build && pnpm --filter @strumentario/evals run eval:agent",
    "clean": "rm -rf packages/*/dist *.tsbuildinfo packages/*/*.tsbuildinfo"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.13.10",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/test-utils": "^2.6.0",
    "svelte": "5.57.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9",
    "vue": "3.5.45"
  }
}
