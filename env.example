# Copy to .env and fill in values. Never commit real secrets.

# Braintrust: `pnpm eval` runs the golden dataset as an experiment when a key is set.
# Without a key, `pnpm eval:local` runs the same cases and scorers offline.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=strumentario

# Optional: OpenAI / Anthropic for AI SDK path or host-side demos
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Server
# Transport: http (Streamable HTTP, default) or stdio (for hosts that spawn the server as a child
# process; same as `serve --stdio`). In stdio mode PORT, HOST and the bearer tokens are unused and stdout carries protocol messages only.
# MCP_TRANSPORT=http
# Agent name attributed to calls over stdio (HTTP callers send the X-Strumentario-Agent header instead).
# STRUMENTARIO_AGENT=
PORT=3001
HOST=127.0.0.1
# Optional shared bearer secret for /mcp (unset = no auth). Set your own; never commit it.
# MCP_AUTH_TOKEN=
# Optional scoped tokens (HTTP only). MCP_READ_TOKEN may call read-only tools (query, validate) and read resources;
# MCP_WRITE_TOKEN may call everything. MCP_AUTH_TOKEN above keeps working and acts as a write token.
# MCP_READ_TOKEN=
# MCP_WRITE_TOKEN=

# Page store (plain JSON files, one per slug). Relative paths resolve from the server's cwd.
# STRUMENTARIO_DATA_DIR=./.strumentario/data

# scaffold tool: directory its outDir is resolved against, and may not leave (default: the server cwd).
# STRUMENTARIO_SCAFFOLD_ROOT=
