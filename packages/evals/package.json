{
  "name": "@strumentario/evals",
  "version": "0.0.0",
  "description": "Braintrust golden traces and scorers for Strumentario content instruments",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "eval": "node --import tsx/esm src/run.ts",
    "eval:local": "node --import tsx/esm src/local.ts",
    "eval:regression": "node --import tsx/esm src/regression.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@strumentario/cli": "workspace:*",
    "@strumentario/server": "workspace:*",
    "ajv": "^8.20.0",
    "braintrust": "^3.43.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  }
}
